#version 430 core

layout(local_size_x = 128) in;

uniform uint u_batch_size;
uniform uint u_input_size;
uniform uint u_output_size;

uniform int u_is_backprop;
uniform int u_is_gradients_increase;
uniform int u_is_gradients_apply;
uniform int u_calculate_loss;
uniform float u_learning_rate;

layout(std430, binding = 0) buffer InputBuffer {
    float inputs[]; // Sampled
};
layout(std430, binding = 1) buffer OutputBuffer {
    float outputs[]; // Sampled
};
layout(std430, binding = 2) buffer WeightsBuffer {
    float weights[]; // Shared
};
layout(std430, binding = 3) buffer BiasesBuffer {
    float biases[]; // Shared
};
layout(std430, binding = 4) buffer TargetsBuffer {
    float targets[]; // Sampled
};
layout(std430, binding = 5) buffer OutputGradientsBuffer {
    float output_gradients[]; // Sampled
};
layout(std430, binding = 6) buffer InputGradientsBuffer {
    float input_gradients[]; // Sampled
};
layout(std430, binding = 7) buffer WeightsGradientsBuffer {
    float w_gradients[]; // Sampled
};
layout(std430, binding = 8) buffer BiasesGradientsBuffer {
    float b_gradients[]; // Sampled
};
layout(std430, binding = 9) buffer weightsTotalGradientsBuffer {
    float w_gradients_total[]; // Shared
};
layout(std430, binding = 10) buffer BiasesTotalGradientsBuffer {
    float b_gradients_total[]; // Shared
};


float activation(float x)
{
    return 1.0 / (1.0 + exp(-x));
}

void forward(uint thread_id)
{
    if(thread_id >= uint(outputs.length())) return;

    uint current_sample = thread_id / u_output_size;
    uint output_neuron_num = thread_id % u_output_size;
    uint input_sample_start = current_sample * u_input_size;

    float sum = biases[output_neuron_num];
    for(int i = 0; i < u_input_size; i++) {
        sum += inputs[i + input_sample_start] * weights[i * u_output_size + output_neuron_num];
    }
    outputs[thread_id] = activation(sum);
}
void calculate_loss(uint thread_id)
{
    if(thread_id >= uint(outputs.length())) return;

    //delta[last_l] = (Al - y) * Al * (1 - Al)
    float A = outputs[thread_id];
    output_gradients[thread_id] = (A - targets[thread_id]) * A * (1.0 - A);
}
void compute_weights(uint thread_id)
{
    if(thread_id >= uint(outputs.length())) return;
    uint current_sample = thread_id / u_output_size;
    uint output_neuron_num = thread_id % u_output_size;
    uint input_sample_start = current_sample * u_input_size;

    uint weights_num_per_layer = u_input_size * u_output_size;
    uint batch_weight_offset = current_sample * weights_num_per_layer;

    // delta Wl = delta[l] * Al-1
    for (uint i = 0; i < u_input_size; i++) {
        uint weight_idx = i * u_output_size + output_neuron_num;
        w_gradients[batch_weight_offset + weight_idx] = 
            output_gradients[thread_id] * inputs[input_sample_start + i];
    }
}
void compute_biases(uint thread_id) 
{
    if(thread_id >= uint(outputs.length())*2 
    || thread_id < uint(outputs.length())) return;
    thread_id -= uint(outputs.length());

    // delta bl = delta[l]
    b_gradients[thread_id] = output_gradients[thread_id];
}
void backpropogation(uint thread_id)
{
    if(thread_id >= uint(inputs.length()+outputs.length())*2
    || thread_id < uint(outputs.length())*2) return;

    thread_id -= uint(outputs.length())*2;
    
    uint current_sample = thread_id / u_input_size;
    uint input_neuron_num = thread_id % u_input_size;
    uint input_sample_start = current_sample * u_input_size;

    // delta[l]-1 = delta[l] * Wl * Al-1 * (1 - Al-1) 
    float sum = 0.0f;
    for (uint i = 0; i < u_output_size; i++) {
        sum += 
            weights[input_neuron_num * u_output_size + i] * 
            output_gradients[current_sample * u_output_size + i];
    }
    float A = inputs[input_sample_start + input_neuron_num];
    float Aderiv = A * (1.0f - A);

    input_gradients[thread_id] = sum * Aderiv;
}
void increaseTotalGradients(uint thread_id)
{
    if(thread_id < uint(w_gradients_total.length())) {
        float sum = 0.0;
        for(int i = 0; i < u_batch_size; i++) {
            sum += w_gradients[thread_id+i*weights.length()];
        }
        sum /= u_batch_size;
        w_gradients_total[thread_id] = sum;
    } else if(thread_id >= uint(w_gradients_total.length())
           && thread_id < uint(w_gradients_total.length()+b_gradients_total.length())) {
        uint b_idx = thread_id-uint(w_gradients_total.length());
        float sum = 0.0;
        for(int i = 0; i < u_batch_size; i++) {
            sum += b_gradients[b_idx+i*biases.length()];
        }
        sum /= u_batch_size;
        b_gradients_total[b_idx] = sum;
    }
}
void applyTotalGradients(uint thread_id)
{
    if(thread_id < uint(weights.length())) {
        weights[thread_id] -= w_gradients_total[thread_id] * u_learning_rate;
    } else if(thread_id >= uint(weights.length())
           && thread_id < uint(weights.length()+biases.length())) {
        uint b_idx = thread_id-uint(weights.length());
        biases[b_idx] -= b_gradients_total[b_idx] * u_learning_rate;
    }
}
void main()
{
    // thread_count is (output_layer_size * batch size) for forward pass
    // and (output_layer_size * u_batch_size + input_layer_size * u_batch_size) for backpropogation
    uint thread_id = gl_GlobalInvocationID.x;

    if(u_is_backprop != 1) {
        if(u_is_gradients_increase == 1) {
            increaseTotalGradients(thread_id);
        } else if(u_is_gradients_apply == 1) {
            applyTotalGradients(thread_id);
        } else {
            forward(thread_id);
        }
    } else {
        if(u_calculate_loss == 1) {
            calculate_loss(thread_id);
        } else {                        // Outputs.length()*2+inputs.length() threads total
            compute_weights(thread_id); //// First outputs.length() count of threads
            compute_biases(thread_id);  //// Second outputs.length() count of threads
            backpropogation(thread_id); //// Last inputs.length() count of threads
        }
    }
}
